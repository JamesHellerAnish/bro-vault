# Capacitor
# android/ IS committed. In live-URL mode it is a thin shell, but it still carries the
# manifest, permissions, icons and Gradle config -- regenerating it on each machine would
# silently drop those. Only the machine-specific and secret parts are ignored.
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/captures/
android/local.properties
android/app/src/main/assets/public/
# Generated by `cap sync`, and coupled to THIS machine's node_modules layout:
# capacitor.settings.gradle hardcodes pnpm store paths including version hashes
# (node_modules/.pnpm/@capacitor+android@8.5.0_.../), and capacitor.build.gradle applies a
# file inside capacitor-cordova-android-plugins/, which Capacitor's own .gitignore excludes.
# Committing either invites a stale copy that fails Gradle at settings evaluation with an
# error that names neither cause. `pnpm cap:sync` regenerates both -- run it after install.
android/capacitor.settings.gradle
android/app/capacitor.build.gradle
# Firebase config: identifies the FCM project. Supplied per-environment, never committed.
android/app/google-services.json
ios/
