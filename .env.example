# Copy to .env.local and fill in. Never commit the filled version (CLAUDE.md).
#
# Local stack: run `supabase start` and copy the values it prints.
# Hosted project: Dashboard -> Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The anon key is the ONLY Supabase key that belongs in this file. The service-role key
# bypasses every RLS policy in supabase/migrations -- it never goes in a NEXT_PUBLIC_
# variable, and for now it has no server-side use either.
